{
	"name": "remark-footnotes-extra",
	"type": "module",
	"version": "0.3.1",
	"files": [
		"dist",
		"assets",
		"README.md",
		"CHANGELOG.md"
	],
	"workspaces": [
		"playground"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsup",
		"dev:plugin": "tsup --watch",
		"dev:playground": "bun run --filter playground dev",
		"dev": "run-p dev:plugin dev:playground",
		"test": "npm run build && npm run test:types && node --test test/*.test.mjs",
		"test:types": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict test/esm.mts test/commonjs.cts",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run typecheck && npm test"
	},
	"dependencies": {
		"@types/mdast": "^4.0.4"
	},
	"devDependencies": {
		"npm-run-all2": "^7.0.1",
		"prettier": "^3.4.2",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.1",
		"tsup": "^8.3.5",
		"typescript": "^5.7.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0"
	},
	"author": {
		"name": "miaobuao",
		"email": "miaobuao@outlook.com"
	},
	"homepage": "https://github.com/miaobuao/remark-footnotes-extra",
	"repository": {
		"type": "git",
		"url": "https://github.com/miaobuao/remark-footnotes-extra"
	},
	"keywords": [
		"remark",
		"footnotes"
	],
	"license": "MIT"
}
